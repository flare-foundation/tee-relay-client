# settable by FLARE_TEE_MANAGER_CONTRACT_ADDRESS instead; set in both places, the two must match
flare_tee_manager = "0xdE25c06982Ab8e4b6B4F910896E3f93Ac77FB44d"

is_cosigner = false

chain_id = 14

[collector]
start_interval = 100 # blocks below the indexer's last block that the initial scan starts at


# C-chain indexer db
[db]
host = "localhost"
port = 3306
database = "flare_ftso_indexer"
username = "root"
password = "root"
log_queries = false

# optional connection-pool limits; omitted = database/sql defaults
# [db.pool]
# max_open_conns = 10
# max_idle_conns = 5
# conn_max_lifetime = "1h"
# conn_max_idle_time = "10m"

# optional TLS; omitted = plaintext. Use "verify" when the indexer is on another host
# [db.tls]
# mode = "verify"                                  # off | skip-verify | verify
# ca_cert = "/etc/tee-relay/db-ca.pem"             # replaces the system roots; verify only
# server_name = "indexer.example.com"              # defaults to host; verify only
# client_cert = "/etc/tee-relay/db-client.pem"     # mutual TLS, set with client_key; verify only
# client_key = "/etc/tee-relay/db-client-key.pem"


[logger]
level = "INFO"     # INFO shows startup/wiring, lifecycle, and failures; per-instruction tracing requires "DEBUG"
file = ""          # log file path; empty = no file. With console = false this discards ALL logs
max_file_size = 10 # MB per rotated file
max_backups = 10   # rotated files kept
max_age_days = 30  # days rotated files are kept
console = true


# Health endpoints are on by default, on port 8080, which the provided Dockerfile EXPOSEs. See README → Health endpoints.
# [health]
# disabled = false           # true turns them off and opens no port; logs a warning
# port = 8080                # all interfaces; a non-default port logs a warning, probes and port mappings must follow it
# max_indexer_lag = "30s"    # /ready answers 503 once the indexer's last block is older than this; default 30s


# credentials for signer
[signer]
local = true # external signer (local = false) is not implemented yet
private_key_variable = "PRIVATE_KEY"
# external signer only
# url = ""
# key_name = ""
# key = ""

# Terminal queue errors are drained and logged by the relay on a best-effort
# basis (error_chan is forced on internally; setting it here has no effect).

[fdc.queues.availability]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"

[fdc.queues.pmw]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"


# Verifier blocks are commented out because server.url must be filled in first:
# the relay rejects a verifier with an empty or invalid URL at startup, and two
# verifiers must not share the same type and source.

# [fdc.verifiers.availability]
# type = "TeeAvailabilityCheck"
# source = "TEE"
# queue = "availability"
# server.url = ""
# server.key_name = "X-API-KEY"
# server.key = ""


# [fdc.verifiers.payment]
# type = "PMWPaymentStatus"
# source = "XRP"
# queue = "pmw"
# server.url = ""
# server.key_name = "X-API-KEY"
# server.key = ""


# [fdc.verifiers.account]
# type = "PMWMultisigAccountConfigured"
# source = "XRP"
# queue = "pmw"
# server.url = ""
# server.key_name = "X-API-KEY"
# server.key = ""
