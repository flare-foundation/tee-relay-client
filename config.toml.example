# C-chain indexer db
[db]
host = "localhost"
port = 3306
database = "flare_ftso_indexer"
username = "root"
password = "root"
log_queries = false

[logger]
max_file_size = 10 # 10MB
file = ""
level = "DEBUG"
console = true


# credentials for signer
[signer]
url = ""
key_name = ""
key = ""


[ftdc.queues.availability]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"


[ftdc.queues.payment]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"


[ftdc.queues.account]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"


[ftdc.verifiers.availability]
type = "TeeAvailabilityCheck"
source = "TEE"
queue = "availability"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""


[ftdc.verifiers.payment]
type = "PMWPaymentStatus"
source = "XRP"
queue = "payment"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""




[ftdc.verifiers.account]
type = "PMWMultisigAccountConfigured"
source = "XRP"
queue = "account"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""
