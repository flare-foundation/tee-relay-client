flare_tee_manager = "0xdE25c06982Ab8e4b6B4F910896E3f93Ac77FB44d"

is_cosigner = false

chain_id = 14

[collector]
start_interval = 100 # blocks below the indexer's last block that the initial scan starts at


# C-chain indexer db
[db]
host = "localhost"
port = 3306
database = "flare_ftso_indexer"
username = "root"
password = "root"
log_queries = false

# optional connection-pool limits; omitted = database/sql defaults
# [db.pool]
# max_open_conns = 10
# max_idle_conns = 5
# conn_max_lifetime = "1h"
# conn_max_idle_time = "10m"


[logger]
level = "INFO"     # INFO shows startup/wiring, lifecycle, and failures; per-instruction tracing requires "DEBUG"
file = ""          # log file path; empty = no file. With console = false this discards ALL logs
max_file_size = 10 # MB per rotated file
max_backups = 10   # rotated files kept
max_age_days = 30  # days rotated files are kept
console = true


# credentials for signer
[signer]
local = true # external signer (local = false) is not implemented yet
private_key_variable = "PRIVATE_KEY"
# external signer only
# url = ""
# key_name = ""
# key = ""

# Terminal queue errors are drained and logged by the relay on a best-effort
# basis (error_chan is forced on internally; setting it here has no effect).

[fdc.queues.availability]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"

[fdc.queues.pmw]
max_dequeues_per_second = 100 # zero for unlimited
max_workers = 50              # zero for unlimited
max_attempts = 3
time_off = "2s"


# server.url must be filled in before FDC2 instructions can be verified; an empty
# URL is not rejected at startup, it fails per instruction at ERROR

[fdc.verifiers.availability]
type = "TeeAvailabilityCheck"
source = "TEE"
queue = "availability"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""


[fdc.verifiers.payment]
type = "PMWPaymentStatus"
source = "XRP"
queue = "pmw"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""


[fdc.verifiers.account]
type = "PMWMultisigAccountConfigured"
source = "XRP"
queue = "pmw"
server.url = ""
server.key_name = "X-API-KEY"
server.key = ""
